{
  "name": "shubh555-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cms": "tsx cms-server/index.ts",
    "dev:all": "concurrently -k -n web,cms -c cyan,magenta \"npm run dev\" \"npm run dev:cms\"",
