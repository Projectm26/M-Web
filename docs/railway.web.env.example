# Copy into Railway → M-Web service → Variables.
#
# VITE_API_BASE_URL is required at Docker *build* time (client bundle).
# PORT / HOST are injected / set by the image — do not override PORT unless needed.

NODE_ENV=production

# Product API public origin (no trailing slash, no /api suffix)
VITE_API_BASE_URL=https://REPLACE_API.up.railway.app

# Hero CMS admin (required for /cms writes). Generate: openssl rand -hex 32
CMS_ACCESS_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Optional — image defaults are fine on Railway
# HOST=0.0.0.0
# PORT is injected by Railway

# After first deploy domain is known, add to API service:
#   ALLOWED_ORIGINS=https://REPLACE_WEB.up.railway.app,...
#
# Volume: mount path /app/data (replicas = 1 while volume attached)
