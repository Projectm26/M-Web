# Shubh555 product API
# Local: Vite proxies /api → this host (no CORS needed)
VITE_API_PROXY_TARGET=https://REPLACE_API.up.railway.app

# Production Docker/Railway builds ONLY — absolute API origin (no /api suffix).
# Leave unset/empty for local `npm run dev`.
# VITE_API_BASE_URL=https://REPLACE_API.up.railway.app

# --- Web-local Hero CMS (SQLite) ---
# Required for /cms admin writes. Generate: openssl rand -hex 32
CMS_ACCESS_KEY=change-me-to-a-long-random-secret

# Optional CMS server port for local `npm run dev:cms` (default 8787)
CMS_PORT=8787

# Optional Vite proxy target for CMS (default http://127.0.0.1:8787)
# VITE_CMS_PROXY_TARGET=http://127.0.0.1:8787

# Production container (set by Dockerfile; override only if needed)
# HOST=0.0.0.0
# PORT=3000
# SERVE_SPA=true
