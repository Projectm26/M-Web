# Shubh555 product API (Vite proxies /api → this host in local dev)
VITE_API_PROXY_TARGET=https://p01--l-b--f8scybsf5kqx.code.run

# Absolute API origin for production builds only (leave empty in local dev)
# VITE_API_BASE_URL=

# --- Web-local Hero CMS (SQLite) ---
# Required for /cms admin writes. Generate a long random string.
CMS_ACCESS_KEY=change-me-to-a-long-random-secret

# Optional CMS server port (default 8787)
CMS_PORT=8787

# Optional Vite proxy target for CMS (default http://127.0.0.1:8787)
# VITE_CMS_PROXY_TARGET=http://127.0.0.1:8787
